  {
    "name": "models",
    "title": "Find timm models",
    "description": "Find available timm model names by family.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "required": [
        "q",
        "limit"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "route": {
      "method": "GET",
      "path": "/models",
      "query": [
        "q",
        "limit"
      ]
    }
  }
]
