[
  {
    "name": "train",
    "title": "Train an image classifier",
    "description": "Train with the native timm form settings, including augmentation, metrics and embeddings. For remote data use plan_data/prepare_data; follow job_status for the run_url.",
    "input_schema": {
      "type": "object",
      "properties": {
        "epochs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 20
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512,
          "default": 32
        },
        "num_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32,
          "default": 8
        },
        "image_size": {
          "type": "integer",
          "minimum": 32,
          "maximum": 1024,
          "default": 224
        },
        "lr": {
          "type": "number",
          "minimum": 1e-05,
          "maximum": 1,
          "default": 0.001
        },
        "weight_decay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.0001
        },
        "optimizer": {
          "type": "string",
          "enum": [
            "adamw",
            "adam",
            "sgd",
            "lamb"
          ],
          "default": "adamw"
        },
        "scheduler": {
          "type": "string",
          "enum": [
            "cosine",
            "step",
            "plateau"
          ],
          "default": "cosine"
        },
        "warmup_epochs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "default": 3
        },
        "auto_augment": {
          "type": "string",
          "enum": [
            "",
            "rand-m9-mstd0.5",
            "rand-m15-mstd0.5",
            "trivialaugment"
          ],
          "default": "rand-m9-mstd0.5"
        },
        "reprob": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "mixup_alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "cutmix_alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "hflip": {
          "type": "boolean",
          "default": true
        },
        "color_jitter": {
          "type": "boolean",
          "default": true
        },
        "image_embeddings_dim": {
          "type": "integer",
          "enum": [
            0,
            2,
            3
          ],
          "default": 2
        },
        "image_embeddings_reducer": {
          "type": "string",
          "enum": [
            "umap",
            "pacmap"
          ],
          "default": "umap"
        },
        "write_full_embeddings": {
          "type": "boolean",
          "default": false
        },
        "collection_epoch_start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            {
              "const": ""
            }
          ],
          "default": ""
        },
        "collection_interval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1
        },
        "collect_loss": {
          "type": "boolean",
          "default": true
        },
        "sampling_weights": {
          "type": "boolean",
          "default": false
        },
        "exclude_zero_weight_training": {
          "type": "boolean",
          "default": false
        },
        "collection_val_only": {
          "type": "boolean",
          "default": false
        },
        "collection_disable": {
          "type": "boolean",
          "default": false
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "run_name": {
          "type": "string",
          "default": ""
        },
        "project_name": {
          "type": "string",
          "default": ""
        },
        "task_type": {
          "type": "string",
          "enum": [
            "",
            "classification",
            "feature_extraction"
          ],
          "default": ""
        },
        "train_table_url": {
          "type": "string",
          "minLength": 1
        },
        "val_table_url": {
          "type": "string",
          "default": ""
        },
        "image_column": {
          "type": "string",
          "minLength": 1
        },
        "label_column": {
          "type": "string",
          "default": ""
        },
        "use_latest": {
          "type": "boolean",
          "default": false
        },
        "device": {
          "type": "string",
          "enum": [
            "",
            "auto",
            "cpu",
            "cuda"
          ],
          "default": "auto"
        },
        "pretrained_model_url": {
          "type": "string",
          "default": ""
        },
        "copy_model_to_run": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false,
      "required": [
        "train_table_url",
        "model",
        "image_column"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "task_type": {
                "const": "feature_extraction"
              }
            },
            "required": [
              "task_type"
            ]
          },
          "else": {
            "properties": {
              "label_column": {
                "minLength": 1
              }
            },
            "required": [
              "label_column"
            ]
          }
        }
      ]
    },
    "job": {
      "body": {
        "project_config": {
          "params": {
            "epochs": "{{epochs}}",
            "batch_size": "{{batch_size}}",
            "num_workers": "{{num_workers}}",
            "image_size": "{{image_size}}",
            "lr": "{{lr}}",
            "weight_decay": "{{weight_decay}}",
            "optimizer": "{{optimizer}}",
            "scheduler": "{{scheduler}}",
            "warmup_epochs": "{{warmup_epochs}}",
            "auto_augment": "{{auto_augment}}",
            "reprob": "{{reprob}}",
            "mixup_alpha": "{{mixup_alpha}}",
            "cutmix_alpha": "{{cutmix_alpha}}",
            "hflip": "{{hflip}}",
            "color_jitter": "{{color_jitter}}",
            "image_embeddings_dim": "{{image_embeddings_dim}}",
            "image_embeddings_reducer": "{{image_embeddings_reducer}}",
            "write_full_embeddings": "{{write_full_embeddings}}",
            "collection_epoch_start": "{{collection_epoch_start}}",
            "collection_interval": "{{collection_interval}}",
            "collect_loss": "{{collect_loss}}",
            "sampling_weights": "{{sampling_weights}}",
            "exclude_zero_weight_training": "{{exclude_zero_weight_training}}",
            "collection_val_only": "{{collection_val_only}}",
            "collection_disable": "{{collection_disable}}",
            "device": "{{device}}",
            "pretrained_model_url": "{{pretrained_model_url}}",
            "copy_model_to_run": "{{copy_model_to_run}}"
          },
          "model_name": "{{model}}",
          "run_name": "{{run_name}}",
          "project_name": "{{project_name}}",
          "task_type": "{{task_type}}",
          "train_table_url": "{{train_table_url}}",
          "val_table_url": "{{val_table_url}}",
          "image_column": "{{image_column}}",
          "label_column": "{{label_column}}",
          "use_latest": "{{use_latest}}",
          "mode": "train"
        },
        "project_name": "{{project_name}}"
      },
      "outputs": [
        "run_url"
      ],
      "wait": false
    }
  },
